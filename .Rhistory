pattern = "^tas_.*\\.txt$", full.names = TRUE)
# Read and combine
future_pr_daily <- map_dfr(pr_files, read_projection)
# Check it worked
future_pr_daily |>
summarise(rows = n(),
simulations = n_distinct(simulation),
first_date = min(date),
