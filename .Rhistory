all_temperature_series |>
dplyr::mutate(location = as.character(location)) |>
dplyr::filter(
!location %in% c("Australia", "Eastern Australia")
),
aus_temp,
eaus_temp
) |>
dplyr::filter(
dplyr::between(year, 1940, 2024),
is.finite(anomaly)
) |>
dplyr::mutate(
location = factor(
location,
levels = c(
"LHI minimum",
"LHI mean",
"LHI maximum",
"Eastern Australia",
"Australia",
"Global land",
"Global ocean"
)
)
)
# --------------------------------------------------
# 3. Calculate trends with HC3 confidence intervals
# --------------------------------------------------
calculate_warming_trend <- function(df) {
mod <- lm(anomaly ~ year, data = df)
robust <- lmtest::coeftest(
mod,
vcov. = sandwich::vcovHC(mod, type = "HC3")
)
slope <- robust["year", "Estimate"]
se <- robust["year", "Std. Error"]
critical <- qt(0.975, df = df.residual(mod))
tibble(
n_years = nrow(df),
warming_decade = slope * 10,
ci_lower = (slope - critical * se) * 10,
ci_upper = (slope + critical * se) * 10,
p_value = robust["year", "Pr(>|t|)"],
r_squared = summary(mod)$r.squared
)
}
warming_trends <- all_temperature_series |>
dplyr::group_by(location) |>
tidyr::nest() |>
dplyr::mutate(
results = purrr::map(data, calculate_warming_trend)
) |>
dplyr::select(-data) |>
tidyr::unnest(results) |>
dplyr::ungroup()
# --------------------------------------------------
# 4. Formatted results table
# --------------------------------------------------
warming_trends_table <- warming_trends |>
dplyr::mutate(
trend = sprintf(
"%+.3f (%.3f to %.3f)",
warming_decade,
ci_lower,
ci_upper
),
p = ifelse(
p_value < 0.001,
"<0.001",
sprintf("%.3f", p_value)
)
) |>
dplyr::select(
Series = location,
`Years (n)` = n_years,
`Warming (°C/decade; 95% CI)` = trend,
`p-value` = p,
`R²` = r_squared
)
print(warming_trends_table, width = Inf)
# --------------------------------------------------
# 5. Plot warming rates
# --------------------------------------------------
warming_rate_plot <- ggplot(
warming_trends,
aes(
x = location,
y = warming_decade,
colour = location
)
) +
geom_pointrange(
aes(
ymin = ci_lower,
ymax = ci_upper
),
linewidth = 2,
size = 3
) +
geom_hline(
yintercept = 0,
linetype = "dashed",
colour = "grey60"
) +
scale_colour_manual(
values = c(
"LHI minimum" = "#C45137",
"LHI mean" = "#E58F64",
"LHI maximum" = "#A83426",
"Eastern Australia" = "#8B4CB7", # Purple
"Australia" = "#119f95",         # Teal
"Global land" = "#6C8533",       # Olive green
"Global ocean" = "#2878B5"       # Blue
)
) +
coord_flip() +
labs(
title = "Historical warming rates: Lord Howe Island and broader regions",
subtitle = "Linear trends, 1940–2024",
x = NULL,
y = "Temperature change (°C/decade)",
caption = paste(
"Points show OLS trends; error bars show HC3 robust 95% confidence intervals.",
"Global ocean represents sea-surface temperature.",
"Sources: CIPSA, BoM ACORN-SAT, Berkeley Earth and HadSST4."
)
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
warming_rate_plot
library(ggplot2)
library(dplyr)
# ------------------------------------------------------------
# 1. PREPARE DATA FOR PLOTTING
# ------------------------------------------------------------
warming_rates_plot <- warming_rates |>
dplyr::mutate(
variable = factor(
variable,
levels = c(
"Global ocean",
"Global land",
"Australia",
"Eastern Australia",
"LHI maximum",
"LHI mean",
"LHI minimum"
)
),
label = sprintf("%.2f", estimate)
)
library(dplyr)
library(ggplot2)
library(readr)
library(tidyr)
library(purrr)
library(sandwich)
library(lmtest)
# ============================================================
# HISTORICAL TEMPERATURE COMPARISON: LHI, AUSTRALIA AND GLOBAL
# ============================================================
# Settings
start_year <- 1940
end_year <- 2024
baseline_start <- 1961
baseline_end <- 1990
# ------------------------------------------------------------
# 1. IMPORT TEMPERATURE DATA
# ------------------------------------------------------------
# Global land temperature - Berkeley Earth
land_url <- paste0(
"https://berkeley-earth-temperature.s3.us-west-1.amazonaws.com/",
"Global/Complete_TAVG_summary.txt"
)
land_raw <- read.table(
land_url,
comment.char = "%",
header = FALSE,
col.names = c(
"year", "anomaly_original", "uncertainty",
"anomaly_5yr", "uncertainty_5yr"
)
)
land_temp <- land_raw |>
dplyr::transmute(
year = as.integer(year),
location = "Global land",
temperature = anomaly_original
)
# Global ocean temperature - Met Office HadSST4
ocean_url <- paste0(
"https://www.metoffice.gov.uk/hadobs/hadsst4/data/data/",
"HadSST.4.2.0.0_annual_GLOBE.csv"
)
ocean_raw <- readr::read_csv(
ocean_url,
show_col_types = FALSE
)
ocean_temp <- tibble::tibble(
year = as.integer(ocean_raw[[1]]),
location = "Global ocean",
temperature = as.numeric(ocean_raw[[2]])
)
# Australia and Eastern Australia - BoM
# These are locally saved files because BoM blocks direct R downloads
read_bom_temperature <- function(file, location_name) {
raw <- read.table(
file,
header = FALSE,
col.names = c("period", "anomaly"),
colClasses = c("character", "numeric")
)
raw |>
dplyr::transmute(
year = as.integer(substr(period, 1, 4)),
location = location_name,
temperature = anomaly
)
}
aus_temp <- read_bom_temperature(
"data/bom_australia_tmean.txt",
"Australia"
)
eaus_temp <- read_bom_temperature(
"data/bom_eastern_australia_tmean.txt",
"Eastern Australia"
)
# LHI minimum, mean and maximum temperatures
lhi_temp <- annual_climate |>
dplyr::select(year, tmin, tmean, tmax) |>
tidyr::pivot_longer(
cols = c(tmin, tmean, tmax),
names_to = "location",
values_to = "temperature"
) |>
dplyr::mutate(
location = dplyr::recode(
location,
tmin = "LHI minimum",
tmean = "Lord Howe Island",
tmax = "LHI maximum"
)
)
# ------------------------------------------------------------
# 2. COMBINE DATA AND CALCULATE ANOMALIES
# ------------------------------------------------------------
all_temperature_data <- dplyr::bind_rows(
lhi_temp,
aus_temp,
eaus_temp,
land_temp,
ocean_temp
) |>
dplyr::filter(
dplyr::between(year, start_year, end_year)
) |>
dplyr::group_by(location) |>
dplyr::mutate(
baseline = mean(
temperature[
dplyr::between(year, baseline_start, baseline_end)
],
na.rm = TRUE
),
anomaly = temperature - baseline
) |>
dplyr::ungroup() |>
dplyr::filter(is.finite(anomaly))
# ------------------------------------------------------------
# 3. COLOURS
# ------------------------------------------------------------
comparison_colours <- c(
"Lord Howe Island" = "#C45137",
"Eastern Australia" = "#8B4CB7",
"Australia" = "#119F95",
"Global land" = "#6C8533",
"Global ocean" = "#2878B5"
)
warming_colours <- c(
"LHI minimum" = "#C45137",
"LHI mean" = "#E58F64",
"LHI maximum" = "#A83426",
"Eastern Australia" = "#8B4CB7",
"Australia" = "#119F95",
"Global land" = "#6C8533",
"Global ocean" = "#2878B5"
)
# ============================================================
# GRAPH 1: HISTORICAL TEMPERATURE ANOMALIES
# ============================================================
comparison_data <- all_temperature_data |>
dplyr::filter(
location %in% names(comparison_colours)
) |>
dplyr::mutate(
location = factor(
location,
levels = names(comparison_colours)
)
)
comparison_plot <- ggplot(
comparison_data,
aes(
x = year,
y = anomaly,
colour = location,
group = location
)
) +
geom_hline(
yintercept = 0,
colour = "grey55",
linewidth = 0.4
) +
# Annual observations
geom_line(
alpha = 0.22,
linewidth = 0.45
) +
# LOESS trends - other regions
geom_smooth(
data = comparison_data |>
dplyr::filter(location != "Lord Howe Island"),
method = "loess",
formula = y ~ x,
se = FALSE,
span = 0.35,
linewidth = 1.15
) +
# LHI trend - emphasised
geom_smooth(
data = comparison_data |>
dplyr::filter(location == "Lord Howe Island"),
method = "loess",
formula = y ~ x,
se = FALSE,
span = 0.35,
linewidth = 1.65
) +
scale_colour_manual(
values = comparison_colours,
breaks = names(comparison_colours)
) +
scale_x_continuous(
breaks = seq(1940, 2025, 10),
limits = c(1940, 2025)
) +
labs(
title = "Lord Howe Island warming in regional and global context",
subtitle = "Annual temperature anomalies relative to 1961–1990",
x = "Year",
y = "Temperature anomaly (°C)",
colour = NULL,
caption = paste(
"Sources: CIPSA, BoM, Berkeley Earth and Met Office HadSST4.",
"Global ocean represents sea-surface temperature."
)
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "bottom",
legend.text = element_text(size = 9),
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank(),
plot.caption = element_text(size = 8, hjust = 0)
) +
guides(
colour = guide_legend(
nrow = 2,
byrow = TRUE,
override.aes = list(
linewidth = 1.5,
alpha = 1
)
)
)
comparison_plot
# ============================================================
# GRAPH 2: LINEAR WARMING RATES WITH 95% CI
# ============================================================
# ------------------------------------------------------------
# 4. PREPARE DATA FOR TREND ANALYSIS
# ------------------------------------------------------------
warming_data <- all_temperature_data |>
dplyr::mutate(
location = if_else(
location == "Lord Howe Island",
"LHI mean",
location
)
) |>
dplyr::mutate(
location = factor(
location,
levels = c(
"LHI minimum",
"LHI mean",
"LHI maximum",
"Eastern Australia",
"Australia",
"Global land",
"Global ocean"
)
)
)
# ------------------------------------------------------------
# 5. CALCULATE LINEAR TRENDS WITH HC3 ROBUST CI
# ------------------------------------------------------------
calculate_warming_trend <- function(df) {
mod <- lm(anomaly ~ year, data = df)
robust <- lmtest::coeftest(
mod,
vcov. = sandwich::vcovHC(mod, type = "HC3")
)
slope <- robust["year", "Estimate"]
se <- robust["year", "Std. Error"]
critical <- qt(
0.975,
df = df.residual(mod)
)
tibble::tibble(
n_years = nrow(df),
warming_decade = slope * 10,
ci_lower = (slope - critical * se) * 10,
ci_upper = (slope + critical * se) * 10,
p_value = robust["year", "Pr(>|t|)"],
r_squared = summary(mod)$r.squared
)
}
warming_trends <- warming_data |>
dplyr::group_by(location) |>
tidyr::nest() |>
dplyr::mutate(
results = purrr::map(data, calculate_warming_trend)
) |>
dplyr::select(-data) |>
tidyr::unnest(results) |>
dplyr::ungroup() |>
dplyr::mutate(
label = sprintf("%.2f", warming_decade)
)
# ------------------------------------------------------------
# 6. PLOT WARMING RATES
# ------------------------------------------------------------
warming_rate_plot <- ggplot(
warming_trends,
aes(
x = location,
y = warming_decade,
colour = location
)
) +
geom_hline(
yintercept = 0,
linetype = "dashed",
colour = "grey60",
linewidth = 0.5
) +
# Horizontal confidence intervals after coord_flip()
geom_pointrange(
aes(
ymin = ci_lower,
ymax = ci_upper
),
linewidth = 1.2,
fatten = 3
) +
# Large coloured dots for labels
geom_point(
size = 10
) +
# Warming rate labels (°C/decade)
geom_text(
aes(label = label),
colour = "white",
fontface = "bold",
size = 3.2
) +
scale_colour_manual(
values = warming_colours
) +
scale_y_continuous(
breaks = seq(0, 0.30, 0.05),
expand = expansion(mult = c(0.03, 0.05))
) +
coord_flip() +
labs(
title = "Historical warming rates: Lord Howe Island and broader regions",
subtitle = "Linear trends, 1940–2024",
x = NULL,
y = "Temperature change (°C/decade)",
caption = paste(
"Points show OLS warming rates; bars show HC3 robust 95% confidence intervals.",
"Global ocean represents sea-surface temperature.",
"Sources: CIPSA, BoM, Berkeley Earth and HadSST4."
)
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "none",
plot.title = element_text(face = "bold"),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10),
panel.grid.minor = element_blank(),
plot.caption = element_text(size = 8, hjust = 0)
)
warming_rate_plot
