geom_point(aes(year, meanmin), colour = "blue") +
geom_smooth(aes(year, meanmin), method = "lm", se = TRUE, colour = "blue") +
annotate("text", x = 2030, y = 17.5, label =change_min , color = "blue", size = 3) +
