downscaling = parts[3],
scenario = parts[4],
member = parts[5],
ocean_coupled = str_detect(downscaling, "oc$"),
# Date variables
date = ymd(date),
year = year(date),
month = month(date),
day = day(date),
# Convert tas from Kelvin to Celsius
tas = value - 273.15) |>
select(date, year, month, day, tas, gcm, downscaling,
ocean_coupled, scenario, member,lon,lat)
}
tas_files <- list.files("data/qld_futuremodels/tas/", pattern = "^tas_.*\\.txt$", full.names = TRUE)
future_tas_daily <- map_dfr(tas_files, read_projection)
# Read in data and clean
read_projection <- function(file) {
# Get filename without path or extension
fname <- tools::file_path_sans_ext(basename(file))
# Split filename into components
parts <- str_split(fname, "_", simplify = TRUE)
# Read data
# Read whitespace-delimited file
dat <- read.table(file, header = TRUE, comment.char = "", check.names = FALSE)
# Remove # from first column name
names(dat)[1] <- "variable"
dat |>
# Metadata from filename
mutate(gcm = parts[2],
downscaling = parts[3],
scenario = parts[4],
member = parts[5],
ocean_coupled = str_detect(downscaling, "oc$"),
# Date variables
date = ymd(date),
year = year(date),
month = month(date),
day = day(date),
# Convert tas from Kelvin to Celsius
tas = value - 273.15) |>
dplyr::select(date, year, month, day, tas, gcm, downscaling,
ocean_coupled, scenario, member,lon,lat)
}
tas_files <- list.files("data/qld_futuremodels/tas/", pattern = "^tas_.*\\.txt$", full.names = TRUE)
future_tas_daily <- map_dfr(tas_files, read_projection)
