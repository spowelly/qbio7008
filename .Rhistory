read_projection <- function(file) {
fname <- tools::file_path_sans_ext(basename(file))
parts <- str_split(fname, "_", simplify = TRUE)
# Read file, ignoring the first header line
dat <- read.table(
file,
skip = 1,
header = FALSE,
col.names = c("variable", "date", "lon", "lat", "value"),
stringsAsFactors = FALSE
)
dat |>
mutate(
# File metadata
gcm = parts[2],
downscaling = parts[3],
scenario = parts[4],
member = parts[5],
ocean_coupled = str_detect(downscaling, "oc$"),
# Date variables
date = ymd(date),
year = year(date),
month = month(date),
day = day(date),
# Kelvin -> Celsius
tas = value - 273.15,
# Unique simulation
simulation = paste(
gcm,
downscaling,
member,
sep = "_"
)
) |>
select(
date,
year,
month,
day,
tas,
simulation,
gcm,
downscaling,
ocean_coupled,
scenario,
member,
lon,
lat
)
}
# Find all tas files
tas_files <- list.files(
