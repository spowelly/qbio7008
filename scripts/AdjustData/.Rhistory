stripeplot <- function(df, var, plotname) {
var_name <- deparse(substitute(var))
col <- df[[var_name]]
stripe_df <- df |>
mutate(temp = col) |>
dplyr::select(c("year", "temp"))
ggstripes(
stripe_df,
plot_type = c("stripes"),
plot_title = plotname)
rm(stripe_df)
}
stripeplot(tempYr, meanmin, "LHI mean min")
