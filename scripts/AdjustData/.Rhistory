m1 <- lm(meantemp ~ year, data = tempYr)
linearmods <- function(df, var) {
var_name <- deparse(substitute(var))
col <- df[[var_name]]
paste(mod, var) <- lm(col ~ year, data = df)
par(mfrow = c(1, 1))
plot(col ~ year, data = df)
abline(paste(mod, var), col = "red", lwd = 2)
}
linearmods(TempYr, meantemp)
linearmods(tempYr, meantemp)
linearmods <- function(df, var) {
var_name <- deparse(substitute(var))
col <- df[[var_name]]
paste("mod", var) <- lm(col ~ year, data = df)
par(mfrow = c(1, 1))
plot(col ~ year, data = df)
abline(paste("mod", var), col = "red", lwd = 2)
}
linearmods(tempYr, meantemp)
linearmods <- function(df, var) {
var_name <- deparse(substitute(var))
form <- reformulate("year", response = var_name)
m1 <- lm(form, data = df)
m0 <- lm(reformulate(NULL, response = var_name), data = df)
par(mfrow = c(1, 1))
plot(form, data = df)
abline(m1, col = "red", lwd = 2)
print(summary(m1))
print(confint(m1))
par(mfrow = c(2, 2))
plot(m1)
par(mfrow = c(1, 1))
acf(residuals(m1))
print(anova(m0, m1))
return(m1)
}
mod_meantemp <- linearmods(tempYr, meantemp)
linearmods <- function(df, var) {
var_name <- deparse(substitute(var))
form <- reformulate("year", response = var_name)
m1 <- lm(form, data = df)
m0 <- lm(as.formula(paste(var_name, "~ 1")), data = df)
par(mfrow = c(1, 1))
plot(form, data = df)
abline(m1, col = "red", lwd = 2)
print(summary(m1))
print(confint(m1))
par(mfrow = c(2, 2))
plot(m1)
par(mfrow = c(1, 1))
acf(residuals(m1))
print(anova(m0, m1))
return(m1)
}
mod_meantemp <- linearmods(tempYr, meantemp)
mod_rainfall <- linearmods(rainYr, rainfall)
mod_rainfall <- linearmods(precipYr, rainfall)
mod_rainfall <- linearmods(precipYr, rain)
